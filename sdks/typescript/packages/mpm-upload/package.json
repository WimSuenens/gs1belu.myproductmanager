{
  "name": "@gs1belu/mpm-upload",
  "version": "1.2.0",
  "description": "Kiota-generated TypeScript client for the GS1 Belgium & Luxembourg My Product Manager Upload API (v17).",
  "license": "MIT",
  "type": "module",
  "types": "./dist/src/index.d.ts",
  "main": "./dist/src/index.js",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/__tests__/**",
    "!dist/**/*.tsbuildinfo"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WimSuenens/gs1belu.myproductmanager.git",
    "directory": "sdks/typescript/packages/mpm-upload"
  },
  "homepage": "https://github.com/WimSuenens/gs1belu.myproductmanager/tree/main/sdks/typescript/packages/mpm-upload#readme",
  "bugs": {
    "url": "https://github.com/WimSuenens/gs1belu.myproductmanager/issues"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "build": "tsc -b",
    "test": "node --test dist/src/__tests__/*.test.js"
  },
  "dependencies": {
    "@microsoft/kiota-bundle": "1.0.0-preview.100"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "@types/node": "^22.0.0"
  }
}
