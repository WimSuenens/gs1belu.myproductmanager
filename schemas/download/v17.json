                ],
                "type": "object",
                "properties": {
                    "languageCode": {
                        "pattern": "[a-z]{2}-[A-Z]{2}",
                        "type": "string"
                    },
                    "value": {
                        "maxLength": 4000,
                        "type": "string"
                    }
                }
            },
            "description5000": {
                "required": [
                    "languageCode",
                    "value"
                ],
                "type": "object",
                "properties": {
                    "languageCode": {
                        "pattern": "[a-z]{2}-[A-Z]{2}",
                        "type": "string"
                    },
                    "value": {
                        "maxLength": 5000,
                        "type": "string"
                    }
                }
            },
            "formattedDescription": {
                "required": [
                    "languageCode",
                    "value"
                ],
                "type": "object",
                "properties": {
                    "languageCode": {
                        "pattern": "[a-z]{2}-[A-Z]{2}",
                        "type": "string"
                    },
                    "value": {
                        "type": "string"
                    },
                    "sequenceNumber": {
                        "type": "integer"
                    }
                }
            },
            "formattedDescription250": {
                "required": [
                    "languageCode",
                    "value"
                ],
                "type": "object",
                "properties": {
                    "languageCode": {
                        "pattern": "[a-z]{2}-[A-Z]{2}",
                        "type": "string"
                    },
                    "value": {
                        "maxLength": 250,
                        "type": "string"
                    },
                    "sequenceNumber": {
                        "type": "integer"
                    }
                }
            },
            "formattedDescription500": {
                "required": [
                    "languageCode",
                    "value"
                ],
                "type": "object",
                "properties": {
                    "languageCode": {
                        "pattern": "[a-z]{2}-[A-Z]{2}",
                        "type": "string"
                    },
                    "value": {
                        "maxLength": 500,
                        "type": "string"
                    },
                    "sequenceNumber": {
                        "type": "integer"
                    }
                }
            },
            "formattedDescription4000": {
                "required": [
                    "languageCode",
                    "value"
                ],
                "type": "object",
                "properties": {
                    "languageCode": {
                        "pattern": "[a-z]{2}-[A-Z]{2}",
                        "type": "string"
                    },
                    "value": {
                        "maxLength": 4000,
                        "type": "string"
                    },
                    "sequenceNumber": {
                        "type": "integer"
                    }
                }
            },
            "formattedDescription5000": {
                "required": [
                    "languageCode",
                    "value"
                ],
                "type": "object",
                "properties": {
                    "languageCode": {
                        "pattern": "[a-z]{2}-[A-Z]{2}",
                        "type": "string"
                    },
                    "value": {
                        "maxLength": 5000,
                        "type": "string"
                    },
                    "sequenceNumber": {
                        "type": "integer"
                    }
                }
            },
            "measurement": {
                "required": [
                    "value",
                    "measurementUnitCode"
                ],
                "type": "object",
                "properties": {
                    "value": {
                        "type": "number"
                    },
                    "measurementUnitCode": {
                        "type": "string"
                    }
                }
            },
            "currency": {
                "required": [
                    "value",
                    "currencyCode"
                ],
                "type": "object",
                "properties": {
                    "value": {
                        "type": "number"
                    },
                    "currencyCode": {
                        "type": "string"
                    }
                }
            },
            "party": {
                "required": [
                    "gln"
                ],
                "type": "object",
                "properties": {
                    "gln": {
                        "pattern": "[0-9]{13}",
                        "type": "string"
                    },
                    "partyName": {
                        "type": "string"
                    }
                }
            },
            "tradeItem": {
                "required": [
                    "gtin",
                    "isConsumerUnit",
                    "unitDescriptorCode",
                    "informationProvider",
                    "tradeItemClassification",
                    "countriesOfSale",
                    "brandName"
                ],
                "type": "object",
                "properties": {
                    "gtin": {
                        "pattern": "[0-9]([0-1]|[3-9])([0-9]{12})",
                        "type": "string"
                    },
                    "isConsumerUnit": {
                        "type": "boolean"
                    },
                    "unitDescriptorCode": {
                        "type": "string"
                    },
                    "informationProvider": {
                        "$ref": "#/components/schemas/party"
                    },
                    "countriesOfSale": {
                        "minItems": 1,
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },
                    "tradeItemDescriptions": {
                        "minItems": 1,
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/description200"
                        }
                    },
                    "brandName": {
                        "maxLength": 70,
                        "type": "string"
                    },
                    "referencedFiles": {
                        "minItems": 1,
                        "type": "array",
                        "items": {
                            "required": [
                                "uniformResourceIdentifier",
                                "referencedFileTypeCode"
                            ],
                            "type": "object",
                            "properties": {
                                "uniformResourceIdentifier": {
                                    "maxLength": 2500,
                                    "type": "string"
                                },
                                "fileFormatName": {
                                    "maxLength": 35,
                                    "type": "string"
                                },
                                "referencedFileTypeCode": {
                                    "type": "string"
                                },
                                "fileName": {
                                    "maxLength": 70,
                                    "type": "string"
                                },
                                "languageCodes": {
                                    "minItems": 1,
                                    "type": "array",
                                    "items": {
                                        "type": "string"
                                    }
                                },
                                "fileEffectiveStartDateTime": {
                                    "type": "string",
                                    "format": "date-time"
                                }
                            }
                        }
                    },
                    "brandOwner": {
                        "$ref": "#/components/schemas/party"
                    },
                    "nextLowerLevelTradeItems": {
                        "minItems": 1,
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "gtin": {
                                    "type": "string"
                                },
                                "quantity": {
                                    "type": "integer"
                                }
                            }
                        }
                    },
                    "tradeItemClassification": {
                        "required": [
                            "gpcCategoryCode"
                        ],
                        "type": "object",
                        "properties": {
                            "gpcCategoryCode": {
                                "type": "string"
                            }
                        }
                    },
                    "tradeItemMeasurements": {
                        "type": "object",
                        "properties": {
                            "netContents": {
                                "minItems": 1,
                                "type": "array",
                                "items": {
                                    "$ref": "#/components/schemas/measurement"
                                }
                            }
                        }
                    },
                    "synchronisationDates": {
                        "type": "object",
                        "properties": {
                            "lastChangeDateTime": {
                                "type": "string",
                                "format": "date-time"
                            },
                            "discontinuedDateTime": {
                                "type": "string",
                                "format": "date-time"
                            }
                        }
                    },
                    "metaData": {
                        "required": [
                            "modified",
                            "created",
                            "status"
                        ],
                        "type": "object",
                        "properties": {
                            "modified": {
                                "type": "object",
                                "properties": {
                                    "date": {
                                        "type": "string",
                                        "format": "date-time"
                                    }
                                }
                            },
                            "created": {
                                "type": "object",
                                "properties": {
                                    "date": {
                                        "type": "string",
                                        "format": "date-time"
                                    }
                                }
                            },
                            "status": {
                                "type": "string"
                            },
                            "isDiscontinued": {
                                "type": "boolean"
                            }
                        }
                    }
                }
            }
        },
        "securitySchemes": {
            "apiKeyHeader": {
                "type": "apiKey",
                "name": "Ocp-Apim-Subscription-Key",
                "in": "header"
            },
            "apiKeyQuery": {
                "type": "apiKey",
                "name": "subscription-key",
                "in": "query"
            }
        }
    },
