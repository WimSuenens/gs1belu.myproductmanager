# Copy to mcp/.env and fill in real values, or set these as real environment
# variables. mcp/.env is git-ignored — never commit real credentials.
#
# Loaded via `uv run --env-file mcp/.env` (see .mcp.json and the "Running locally"
# section of mcp/README.md). ServerConfig.from_env() reads these from the process
# environment at server startup — see mcp/src/gs1belu_mpm_mcp/config.py.

GS1BELU_ENVIRONMENT=uat
# GS1BELU_API_VERSION=v17

GS1BELU_UPLOAD_CLIENT_ID=
GS1BELU_UPLOAD_CLIENT_SECRET=
GS1BELU_UPLOAD_SUBSCRIPTION_KEY=

GS1BELU_DOWNLOAD_CLIENT_ID=
GS1BELU_DOWNLOAD_CLIENT_SECRET=
GS1BELU_DOWNLOAD_SUBSCRIPTION_KEY=
